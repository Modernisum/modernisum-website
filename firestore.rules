rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Schools & Workspaces: Public read for school's own profile, public create on onboarding, status updates
    match /schools/{schoolId} {
      allow read: if true;
      allow create: if request.resource.data.name is string && request.resource.data.schoolCode is string;
      allow update: if true;
      allow delete: if request.auth != null;
    }

    // Blogs: Public read, local admin write
    match /blogs/{blogId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    
    // Comments: Public read approved, public create, admin manage
    match /blog_comments/{commentId} {
      allow read: if resource.data.isApproved == true || request.auth != null;
      allow create: if request.resource.data.authorName is string 
                    && request.resource.data.commentText is string;
      allow update, delete: if request.auth != null;
    }
    
    // Enquiries / Leads: Public create, admin read
    match /enquiries/{enquiryId} {
      allow create: if request.resource.data.email is string;
      allow read, write: if request.auth != null;
    }

    // Marketing Leads: Public capture for frictionless lead gen, admin manage
    match /marketing_leads/{leadId} {
      allow read: if true;
      allow create, update: if request.resource.data.email is string;
      allow delete: if request.auth != null;
    }

    // Users Profile: Allow read/write for user registration and school administration
    match /users/{userId} {
      allow read, write: if true;
    }

    // Community Entries (Reviews, Complaints, Feature Requests, Real Testimonials): Public read, public create, admin manage
    match /community_entries/{entryId} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if true;
    }

    // Platform Users & Real Enterprise Customers
    match /platform_users/{userId} {
      allow read, write: if true;
    }

    // Platform Releases (MOD School OS, Employee App, Student App, Clerk Co-Pilot)
    match /platform_releases/{releaseId} {
      allow read: if true;
      allow write: if true;
    }

    // Site Settings & Homepage Telemetry Metrics: Public read, admin manage
    match /site_settings/{docId} {
      allow read: if true;
      allow write: if true;
    }
  }
}
